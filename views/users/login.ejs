<% layout('../views/layouts/boilerplate.ejs') -%>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fa-regular fa-compass" style="font-size:2.5rem;color:var(--color-primary)"></i>
        </div>
        <h4 class="text-center mb-4" id="loginTitle">Welcome back</h4>
        <p class="text-center" style="color:var(--color-text-secondary);margin-top:-12px;margin-bottom:24px;font-size:var(--font-size-sm)">Log in to continue to WanderLust</p>

        <form action="/login" method="POST" novalidate class="needs-validation" id="loginForm">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" placeholder="Enter username" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter your username.</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter password" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter your password.</div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-danger w-100" id="loginBtn" style="padding:14px">
                    <i class="fa-solid fa-right-to-bracket"></i> Log In
                </button>
            </div>
        </form>
        <p class="text-center mt-4" style="font-size:var(--font-size-sm);color:var(--color-text-secondary)">
            Don't have an account? <a href="/signup" style="font-weight:var(--font-weight-semibold)">Sign up</a>
        </p>
    </div>
</div>