<% layout('../views/layouts/boilerplate.ejs') -%>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="fa-regular fa-compass" style="font-size:2.5rem;color:var(--color-primary)"></i>
        </div>
        <h4 class="text-center mb-4" id="signupTitle">Create your account</h4>
        <p class="text-center" style="color:var(--color-text-secondary);margin-top:-12px;margin-bottom:24px;font-size:var(--font-size-sm)">Join WanderLust and start exploring</p>

        <form action="/signup" method="POST" novalidate class="needs-validation" id="signupForm">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" placeholder="Choose a username" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter a username.</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" placeholder="your@email.com" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter a valid email.</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" placeholder="Create a password" class="form-control" required>
                <div class="valid-feedback">Looks good!</div>
                <div class="invalid-feedback">Please enter a password.</div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-danger w-100" id="signupBtn" style="padding:14px">
                    <i class="fa-solid fa-user-plus"></i> Sign Up
                </button>
            </div>
        </form>
        <p class="text-center mt-4" style="font-size:var(--font-size-sm);color:var(--color-text-secondary)">
            Already have an account? <a href="/login" style="font-weight:var(--font-weight-semibold)">Log in</a>
        </p>
    </div>
</div>