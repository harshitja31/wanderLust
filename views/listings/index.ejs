<% layout('../views/layouts/boilerplate.ejs') -%>

    <body>

        <!-- Category Filters -->
        <div id="filters">
            <div class="filter" data-category="Rooms">
                <div><i class="fa-solid fa-hotel"></i></div>
                <p class="filter-text">Rooms</p>
            </div>
            <div class="filter" data-category="Amazing Pools">
                <div><i class="fa-solid fa-water-ladder"></i></div>
                <p class="filter-text">Amazing Pools</p>
            </div>
            <div class="filter" data-category="Farms">
                <div><i class="fa-solid fa-house"></i></div>
                <p class="filter-text">Farms</p>
            </div>
            <div class="filter" data-category="Beachfront">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p class="filter-text">Beachfront</p>
            </div>
            <div class="filter" data-category="Islands">
                <div><i class="fa-solid fa-hotel"></i></div>
                <p class="filter-text">Islands</p>
            </div>
            <div class="filter" data-category="Top cities">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p class="filter-text">Top cities</p>
            </div>
            <div class="filter" data-category="Arctic">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p class="filter-text">Arctic</p>
            </div>
            <div class="filter" data-category="Mountains">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p class="filter-text">Mountains</p>
            </div>
            <div class="filter" data-category="Camping">
                <div><i class="fa-solid fa-campground"></i></div>
                <p class="filter-text">Camping</p>
            </div>
            <div class="filter" data-category="Lakefronts">
                <div><i class="fa-solid fa-house-flood-water"></i></div>
                <p class="filter-text">Lakefronts</p>
            </div>
            <div class="text-switch ms-auto">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
                </div>
            </div>
        </div>

        <!-- Listing Cards Grid -->
        <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1">
            <% allListings.forEach(listing=> { %>
                <a href="/listings/<%= listing._id %>" class="listings-links" id="listing-<%= listing._id %>">
                    <div class="card col listing-card">
                        <img src="<%= listing.image.url %>" class="card-img-top listing-card-img" alt="<%= listing.title %>" loading="lazy">
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b>
                                <% if (listing.price && typeof listing.price==='number' ) { %>
                                    &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
                                        <% } else { %>
                                            Price not available
                                            <% } %>
                                                <i class="text-info">&nbsp; + &nbsp;18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <% }); %>
        </div>

        <!-- Pagination Controls -->
        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
            <nav aria-label="Page navigation" class="mt-4 mb-4 d-flex justify-content-center" id="paginationNav">
                <ul class="pagination pagination-md">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="/listings?page=<%= currentPage - 1 %>">
                            <i class="fa-solid fa-chevron-left" style="font-size:0.75rem"></i> Prev
                        </a>
                    </li>

                    <% for(let i=1; i <=totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link bg-<%= currentPage === i ? 'danger border-danger' : 'light text-dark' %>"
                                href="/listings?page=<%= i %>">
                                <%= i %>
                            </a>
                        </li>
                        <% } %>

                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="/listings?page=<%= currentPage + 1 %>">
                                    Next <i class="fa-solid fa-chevron-right" style="font-size:0.75rem"></i>
                                </a>
                            </li>
                </ul>
            </nav>
            <% } %>

        <!-- FAB: Quick add listing (visible on mobile) -->
        <a href="/listings/new" class="fab" id="fabAddListing" aria-label="Create new listing">
            <i class="fa-solid fa-plus"></i>
        </a>

        <script>
            let toggleSwitch = document.getElementById("flexSwitchCheckDefault");
            toggleSwitch.addEventListener("click", () => {
                let textInfo = document.getElementsByClassName("text-info");
                for (let info of textInfo) {
                    if (info.style.display != "inline") {
                        info.style.display = "inline"
                    } else {
                        info.style.display = "none"
                    }
                }
            })
        </script>
    </body>