<% layout('../views/layouts/boilerplate') -%>
<body>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <!-- Listing Title -->
        <h1 class="title" id="listingTitle"><%= listing.title %></h1>
        
        <!-- Main Listing Card -->
        <div class="card card-custom mb-4" id="listingCard">
            <img src="<%= listing.image.url %>" class="card-img-top show-img mb-3" alt="<%= listing.title %>" loading="lazy">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fa-solid fa-location-dot" style="color:var(--color-primary);margin-right:6px"></i>
                    <%= listing.location %>, <%= listing.country %>
                </h5>
                <p class="card-text" style="margin-bottom:var(--space-sm)">
                    <b>Owned by:</b>&nbsp;
                    <% if (listing.owner && listing.owner.username) { %>
                        <i><%= listing.owner.username %></i>
                    <% } else { %>
                        <i>Unknown Owner</i>
                    <% } %>
                </p>
                <p class="card-text" style="margin-bottom:var(--space-md);line-height:1.6">
                    <%= listing.description %>
                </p>
                <p class="card-text" style="font-size:var(--font-size-lg);font-weight:var(--font-weight-semibold);color:var(--color-text-primary)">
                    <% if (listing.price && typeof listing.price === 'number') { %>
                        &#8377;<%= listing.price.toLocaleString("en-IN") %> <span style="font-weight:400;font-size:var(--font-size-sm);color:var(--color-text-secondary)">/ night</span>
                    <% } else { %>
                        Price not available
                    <% } %>
                </p>

             <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary" id="editListingBtn">
                        <i class="fa-solid fa-pen-to-square"></i> Edit
                    </a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger" id="deleteListingBtn">
                            <i class="fa-solid fa-trash-can"></i> Delete
                        </button>
                    </form>
                </div>
               <% } %>                           
            </div>
        </div>

        <hr>

        <!-- Leave a Review -->
        <% if(currUser) { %>
        <div class="mb-4" id="reviewFormSection">
            <h3>Leave a Review</h3>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation" id="reviewForm">
               
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label"><b>Rating</b></label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label"><b>Comment</b></label>
                    <textarea name="review[comment]" id="comment" class="form-control" required placeholder="Share your experience..."></textarea>
                    <div class="invalid-feedback">Please add a valid Comment</div>
                </div>
                <div class="mb-3 mt-3">
                    <button type="submit" class="btn btn-danger mb-3" id="submitReviewBtn">
                        <i class="fa-solid fa-paper-plane"></i> Submit Review
                    </button>
                </div>
            </form>
            <hr>
        </div>
        <% } %>

        <!-- Reviews Section -->
       <% if(listing.reviews.length > 0) { %>
        <div class="mb-4" id="reviewsSection">
            <h4 class="mb-3">
                <i class="fa-solid fa-star" style="color:var(--color-warning);margin-right:6px"></i>
                Reviews (<%= listing.reviews.length %>)
            </h4>
            <div class="row g-3">
                <% for (let review of listing.reviews) { %>
                    <div class="col-12 col-md-6">
                        <div class="review-card" id="review-<%= review._id %>">
                            <h6 class="card-title mt-2">
                                <i class="fa-solid fa-circle-user" style="margin-right:4px"></i>
                                @<%= review.author.username %>
                            </h6>
                            <p class="starability-result mt-2" data-rating="<%= review.rating %>"></p>
                            <p class="card-text"><%= review.comment %></p>
                           
                            <form class="mb-2" action="/listings/<%= listing._id %>/reviews/<%= review._id  %>?_method=DELETE" method="POST">
                                <button class="btn btn-sm btn-dark" style="width:auto;min-height:36px">
                                    <i class="fa-solid fa-trash-can"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
        <% } %>

        <!-- Map Section -->
        <div class="mb-4" id="mapSection">
            <h4 class="mb-3">
                <i class="fa-solid fa-map-location-dot" style="color:var(--color-accent);margin-right:6px"></i>
                Where you'll be
            </h4>
            <div id="map"></div>
        </div>
    </div>
</div>
<script src="/js/map.js"></script>
</body>
