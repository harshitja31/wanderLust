<% layout('../views/layouts/boilerplate.ejs') -%>
    <div class="row mt-3">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <div class="card card-custom">
                <h3 class="text-center mb-4" id="editListingTitle">
                    <i class="fa-solid fa-pen-to-square" style="color:var(--color-primary);margin-right:8px"></i>
                    Edit Your Listing
                </h3>
                <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation"
                    enctype="multipart/form-data" novalidate id="editListingForm">
                    <%- include('../includes/_listingForm.ejs') %>

                    <!-- Submit Button -->
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-danger" id="updateListingBtn">
                            <i class="fa-solid fa-check"></i> Update Listing
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>