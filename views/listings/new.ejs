<% layout('../views/layouts/boilerplate.ejs') -%>
    <div class="row mt-3">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <div class="card card-custom">
                <h3 class="text-center mb-4" id="newListingTitle">
                    <i class="fa-solid fa-plus-circle" style="color:var(--color-primary);margin-right:8px"></i>
                    Create a New Listing
                </h3>
                <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data" id="newListingForm">
                    <%- include('../includes/_listingForm.ejs') %>

                    <!-- Submit Button -->
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-danger" id="addListingBtn">
                            <i class="fa-solid fa-paper-plane"></i> Add Listing
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>