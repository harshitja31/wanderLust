# ===========================================
# WanderLust - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control!
# ===========================================

# ---- MongoDB Atlas ----
# Connection string from MongoDB Atlas dashboard
ATLAS_DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>

# ---- Cloudinary (Image uploads) ----
# Get these from: https://console.cloudinary.com/settings
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# ---- Mapbox (Geocoding & Maps) ----
# Get this from: https://account.mapbox.com/access-tokens/
MAP_TOKEN=pk.your_mapbox_public_token

# ---- Session ----
# A strong, random secret for signing session cookies
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET=your_session_secret_here

# ---- Server ----
PORT=8080
